# To build the mapper index, you'll need a musicbrainz-docker data instance with the
# LB canonical data fully built:
# mbid_mapper/manage.py canonical-data --use-mb-conn

# To use a DB on this node with DB exposed on port 5432:
CANONICAL_MUSICBRAINZ_DATA_CONNECT="dbname=musicbrainz_db user=musicbrainz host=localhost port=5432 password=musicbrainz"

# SERVER CONFIGURATION
HOST="127.0.0.1"
PORT=5000
TEMPLATE_DIR="./templates"
INDEX_DIR="index"

# Number of threads for the server (default: number of CPU cores)
NUM_THREADS=0

# Number of threads for the server (default: number of CPU cores)
NUM_BUILD_THREADS=0

# Maximum number of items in the index cache
MAX_CACHE_ITEMS=50000

# Trim cache to this many items below max when cleaner runs
CACHE_TRIM_COUNT=10000

# Run the cache cleaner, in seconds
CACHE_CLEANER_DELAY=30